# 1. Frontend-to-backend connection.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=https://hirova.in

# Supabase Auth: public client configuration for email and Google login.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# 2. Groq is the default free-tier provider; switch to gemini or demo if preferred.
LLM_PROVIDER=demo
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 3. Local Docker services; SQLite and in-memory vectors work without these.
DATABASE_URL=postgresql+asyncpg://hirova:hirova@postgres:5432/hirova
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
CORS_ORIGINS=http://localhost:3000

# 4. Optional production tracing. Never commit real keys.
LANGSMITH_TRACING=false
BOOTSTRAP_DATABASE=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hirova-career-copilot
